// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(nanoid())
  title       String
  description String
  price       Float?
  startTime   String
  endTime     String
  adhocLocation AdhocLocation?
  venue      Venue?    @relation(fields: [venueId], references: [id])
  venueId    Int?
  contactEmail String
  hyperlink    String?
  imageURL     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([venueId, startTime])
  @@index([startTime])
}

model Venue {
  id        Int  @id @default(autoincrement())
  name      String
  address   String
  zipCode  String
  city      String
  contactEmail String
  imageURL     String?
  events    Event[]
}

model AdhocLocation {
  eventId   String  @id
  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  address   String
  zipCode   String
  city      String
}
