    "@radix-ui/react-slot": "^1.2.4",
    "better-auth": "^1.3.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "graphql-scalars": "^1.25.0",
